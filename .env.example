# Public site URL used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://hyprrretail.com

# Google Analytics 4 measurement ID (optional; analytics load only when set).
NEXT_PUBLIC_GA_ID=

# Catalog request email delivery (Resend). The form returns an honest error
# until these are configured — no fake success states.
RESEND_API_KEY=
CATALOG_TO_EMAIL=
CATALOG_FROM_EMAIL=
